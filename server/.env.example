PORT=5000
NODE_ENV=production

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT & Security
JWT_SECRET=your_jwt_secret_key_here

# External Compiler / Sandbox configuration
CODE_EXECUTION_TIMEOUT_MS=5000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# PyCode Student Platform Integration
PYCODE_BASE_URL=https://pycode-student.vercel.app
PYCODE_API_KEY=your_pycode_api_key_here

# Resend / SMTP Email Delivery (for 8-digit OTP Verification)
RESEND_API_KEY=re_your_resend_api_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM=Rishabhlabs <rishabhlabs@vrindopnishad.in>
